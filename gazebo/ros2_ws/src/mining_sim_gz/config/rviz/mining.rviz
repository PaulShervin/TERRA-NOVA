Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 5
      Plane Cell Count: 40
    - Class: rviz_default_plugins/Map
      Name: Occupancy map (explorer)
      Enabled: true
      Topic: {Value: /map}
      Alpha: 0.7
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR sweep
      Enabled: true
      Topic: {Value: /lidar/points}
      Size (m): 0.05
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/PointCloud2
      Name: Label-free segmentation
      Enabled: true
      Topic: {Value: /semantic/points}
      Size (m): 0.12
      Style: Points
      Color Transformer: RGB8
    - Class: rviz_default_plugins/Path
      Name: Ground truth (blue)
      Enabled: true
      Topic: {Value: /slam/gt_path}
      Color: 60; 120; 255
      Line Style: Lines
    - Class: rviz_default_plugins/Path
      Name: Odometry only (red)
      Enabled: true
      Topic: {Value: /slam/odom_path}
      Color: 255; 77; 77
      Line Style: Lines
    - Class: rviz_default_plugins/Path
      Name: SLAM estimate (green)
      Enabled: true
      Topic: {Value: /slam/path}
      Color: 53; 255; 140
      Line Style: Lines
    - Class: rviz_default_plugins/MarkerArray
      Name: Loop closures
      Enabled: true
      Topic: {Value: /slam/loop_closures}
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Topic: {Value: /explore/path}
      Color: 255; 210; 58
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Image
      Name: Robot camera
      Enabled: false
      Topic: {Value: /camera/image_raw}
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 60
      Pitch: 1.0
      Yaw: 0.8
